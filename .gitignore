build/
build-*/
.cache/
*.user
*.user.*
CMakeLists.txt.user

# Editors
.vscode/
.idea/
*.swp
/icons/

# Fonts, stickers and Whisper models are addons now — built and published from the drift-addons
# repo, downloaded at runtime into <AppDataLocation>/addons/. These directories are only local
# development overrides, pointed at with DRIFT_FONTS_DIR / DRIFT_STICKERS_DIR /
# DRIFT_WHISPER_MODEL_DIR, and are never part of a build.
/fonts/
stickers/
emoji-fonts/
resources/stickers/
/models/

# Sample media (kept out of the repo)
*.mp4
*.mov
*.mkv
*.webm
*.wav
*.mp3

# Flatpak build artifacts (build-dir is already covered by build-*/ above)
.flatpak-builder/
flatpak/build-dir/
flatpak/repo/
flatpak/dist/

# Release build artifacts (produced by .github/workflows/package.yml, and by makepkg /
# Inno Setup when those are run locally)
/dist/
/AppDir/
/.deps/
/vcpkg/
/vcpkg_bincache/
packaging/arch/src/
packaging/arch/pkg/
packaging/arch/*.pkg.tar.zst
installer/windows/output/

# OS
.DS_Store

# Compiled Qt translations (generated into the build tree; never commit)
*.qm

# Local credential files — never commit
.env
.env.*
