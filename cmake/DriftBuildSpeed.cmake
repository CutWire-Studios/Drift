if(MSVC OR ANDROID OR EMSCRIPTEN)
    return()
endif()

include(CheckLinkerFlag)

set(DRIFT_LINKER "auto" CACHE STRING "Linker: auto, mold, lld, gold or default")
set_property(CACHE DRIFT_LINKER PROPERTY STRINGS auto mold lld gold default)

set(_drift_linker "default")
if(DRIFT_LINKER STREQUAL "auto")
    if(NOT APPLE)
        foreach(_cand mold lld gold)
            check_linker_flag(CXX "-fuse-ld=${_cand}" DRIFT_LINKER_HAS_${_cand})
            if(DRIFT_LINKER_HAS_${_cand})
                set(_drift_linker ${_cand})
                break()
            endif()
        endforeach()
    endif()
elseif(NOT DRIFT_LINKER STREQUAL "default")
    check_linker_flag(CXX "-fuse-ld=${DRIFT_LINKER}" DRIFT_LINKER_HAS_${DRIFT_LINKER})
    if(NOT DRIFT_LINKER_HAS_${DRIFT_LINKER})
        message(FATAL_ERROR "DRIFT_LINKER=${DRIFT_LINKER} is not supported by this compiler/toolchain")
    endif()
    set(_drift_linker ${DRIFT_LINKER})
endif()
if(NOT _drift_linker STREQUAL "default")
    add_link_options("-fuse-ld=${_drift_linker}")
endif()
message(STATUS "Drift linker: ${_drift_linker}")

option(DRIFT_CCACHE "Use ccache as the compiler launcher when available" ON)
if(DRIFT_CCACHE AND NOT CMAKE_CXX_COMPILER_LAUNCHER)
    find_program(DRIFT_CCACHE_PROGRAM ccache)
    if(DRIFT_CCACHE_PROGRAM)
        set(CMAKE_C_COMPILER_LAUNCHER "${DRIFT_CCACHE_PROGRAM}")
        set(CMAKE_CXX_COMPILER_LAUNCHER "${DRIFT_CCACHE_PROGRAM}")
        message(STATUS "Drift ccache: ${DRIFT_CCACHE_PROGRAM}")
    endif()
endif()

if(CMAKE_BUILD_TYPE STREQUAL "Debug" AND NOT APPLE)
    set(_drift_split_dwarf ON)
else()
    set(_drift_split_dwarf OFF)
endif()
option(DRIFT_SPLIT_DWARF "Emit split DWARF debug info in Debug builds" ${_drift_split_dwarf})
if(DRIFT_SPLIT_DWARF AND NOT APPLE)
    add_compile_options("$<$<CONFIG:Debug>:-gsplit-dwarf>")
    if(_drift_linker MATCHES "^(mold|lld|gold)$")
        add_link_options("$<$<CONFIG:Debug>:LINKER:--gdb-index>")
    endif()
endif()
