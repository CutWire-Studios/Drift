{
  "id": "color.grade",
  "displayName": "Color Grade",
  "category": "color",
  "thumbnail": "thumbnail.webp",
  "order": 5,
  "nextFeatures": ["param:curve", "curve:spline", "param:lut"],
  "parameters": [
    { "identifier": "exposure", "displayName": "Exposure", "type": "float", "group": "Light", "minValue": -4, "maxValue": 4, "defaultValue": 0 },
    { "identifier": "contrast", "displayName": "Contrast", "type": "float", "group": "Light", "minValue": -1, "maxValue": 1, "defaultValue": 0 },
    { "identifier": "highlights", "displayName": "Highlights", "type": "float", "group": "Light", "minValue": -1, "maxValue": 1, "defaultValue": 0 },
    { "identifier": "shadows", "displayName": "Shadows", "type": "float", "group": "Light", "minValue": -1, "maxValue": 1, "defaultValue": 0 },
    { "identifier": "whites", "displayName": "Whites", "type": "float", "group": "Light", "minValue": -1, "maxValue": 1, "defaultValue": 0 },
    { "identifier": "blacks", "displayName": "Blacks", "type": "float", "group": "Light", "minValue": -1, "maxValue": 1, "defaultValue": 0 },

    { "identifier": "temperature", "displayName": "Temperature", "type": "float", "track": "temperature", "group": "Color", "minValue": -1, "maxValue": 1, "defaultValue": 0 },
    { "identifier": "tint", "displayName": "Tint", "type": "float", "track": "tint", "group": "Color", "minValue": -1, "maxValue": 1, "defaultValue": 0 },
    { "identifier": "saturation", "displayName": "Saturation", "type": "float", "group": "Color", "minValue": 0, "maxValue": 2, "defaultValue": 1 },
    { "identifier": "vibrance", "displayName": "Vibrance", "type": "float", "group": "Color", "minValue": -1, "maxValue": 1, "defaultValue": 0 },

    { "identifier": "lift", "displayName": "Shadows Color", "type": "vec2", "widget": "colorWheel", "group": "Wheels", "groupCollapsed": true, "minValue": [-1, -1], "maxValue": [1, 1], "defaultValue": [0, 0] },
    { "identifier": "liftLuma", "displayName": "Shadows Brightness", "type": "float", "track": "luma", "group": "Wheels", "groupCollapsed": true, "minValue": -1, "maxValue": 1, "defaultValue": 0 },
    { "identifier": "gamma", "displayName": "Midtones Color", "type": "vec2", "widget": "colorWheel", "group": "Wheels", "groupCollapsed": true, "minValue": [-1, -1], "maxValue": [1, 1], "defaultValue": [0, 0] },
    { "identifier": "gammaLuma", "displayName": "Midtones Brightness", "type": "float", "track": "luma", "group": "Wheels", "groupCollapsed": true, "minValue": -1, "maxValue": 1, "defaultValue": 0 },
    { "identifier": "gain", "displayName": "Highlights Color", "type": "vec2", "widget": "colorWheel", "group": "Wheels", "groupCollapsed": true, "minValue": [-1, -1], "maxValue": [1, 1], "defaultValue": [0, 0] },
    { "identifier": "gainLuma", "displayName": "Highlights Brightness", "type": "float", "track": "luma", "group": "Wheels", "groupCollapsed": true, "minValue": -1, "maxValue": 1, "defaultValue": 0 },

    { "identifier": "curveMaster", "displayName": "Master Curve", "type": "curve", "curveChannel": "master", "group": "Curves", "groupCollapsed": true, "defaultValue": [{"x": 0, "y": 0, "ease": "spline"}, {"x": 1, "y": 1, "ease": "spline"}] },
    { "identifier": "curveR", "displayName": "Red Curve", "type": "curve", "curveChannel": "r", "group": "Curves", "groupCollapsed": true, "defaultValue": [{"x": 0, "y": 0, "ease": "spline"}, {"x": 1, "y": 1, "ease": "spline"}] },
    { "identifier": "curveG", "displayName": "Green Curve", "type": "curve", "curveChannel": "g", "group": "Curves", "groupCollapsed": true, "defaultValue": [{"x": 0, "y": 0, "ease": "spline"}, {"x": 1, "y": 1, "ease": "spline"}] },
    { "identifier": "curveB", "displayName": "Blue Curve", "type": "curve", "curveChannel": "b", "group": "Curves", "groupCollapsed": true, "defaultValue": [{"x": 0, "y": 0, "ease": "spline"}, {"x": 1, "y": 1, "ease": "spline"}] },

    { "identifier": "curveHueHue", "displayName": "Hue vs Hue", "type": "curve", "curveChannel": "hue", "group": "Hue Curves", "groupCollapsed": true, "curveMode": "hue", "defaultValue": [{"x": 0, "y": 0.5, "ease": "spline"}, {"x": 1, "y": 0.5, "ease": "spline"}] },
    { "identifier": "curveHueSat", "displayName": "Hue vs Saturation", "type": "curve", "curveChannel": "sat", "group": "Hue Curves", "groupCollapsed": true, "curveMode": "hue", "defaultValue": [{"x": 0, "y": 0.5, "ease": "spline"}, {"x": 1, "y": 0.5, "ease": "spline"}] },
    { "identifier": "curveHueLum", "displayName": "Hue vs Luminance", "type": "curve", "curveChannel": "lum", "group": "Hue Curves", "groupCollapsed": true, "curveMode": "hue", "defaultValue": [{"x": 0, "y": 0.5, "ease": "spline"}, {"x": 1, "y": 0.5, "ease": "spline"}] },

    { "identifier": "hslRedHue", "displayName": "Red Hue", "type": "float", "track": "hue:0", "group": "HSL", "groupCollapsed": true, "minValue": -1, "maxValue": 1, "defaultValue": 0 },
    { "identifier": "hslRedSat", "displayName": "Red Saturation", "type": "float", "track": "sat:0", "group": "HSL", "groupCollapsed": true, "minValue": -1, "maxValue": 1, "defaultValue": 0 },
    { "identifier": "hslRedLum", "displayName": "Red Luminance", "type": "float", "track": "lum:0", "group": "HSL", "groupCollapsed": true, "minValue": -1, "maxValue": 1, "defaultValue": 0 },

    { "identifier": "hslOrangeHue", "displayName": "Orange Hue", "type": "float", "track": "hue:30", "group": "HSL", "groupCollapsed": true, "minValue": -1, "maxValue": 1, "defaultValue": 0 },
    { "identifier": "hslOrangeSat", "displayName": "Orange Saturation", "type": "float", "track": "sat:30", "group": "HSL", "groupCollapsed": true, "minValue": -1, "maxValue": 1, "defaultValue": 0 },
    { "identifier": "hslOrangeLum", "displayName": "Orange Luminance", "type": "float", "track": "lum:30", "group": "HSL", "groupCollapsed": true, "minValue": -1, "maxValue": 1, "defaultValue": 0 },

    { "identifier": "hslYellowHue", "displayName": "Yellow Hue", "type": "float", "track": "hue:60", "group": "HSL", "groupCollapsed": true, "minValue": -1, "maxValue": 1, "defaultValue": 0 },
    { "identifier": "hslYellowSat", "displayName": "Yellow Saturation", "type": "float", "track": "sat:60", "group": "HSL", "groupCollapsed": true, "minValue": -1, "maxValue": 1, "defaultValue": 0 },
    { "identifier": "hslYellowLum", "displayName": "Yellow Luminance", "type": "float", "track": "lum:60", "group": "HSL", "groupCollapsed": true, "minValue": -1, "maxValue": 1, "defaultValue": 0 },

    { "identifier": "hslGreenHue", "displayName": "Green Hue", "type": "float", "track": "hue:120", "group": "HSL", "groupCollapsed": true, "minValue": -1, "maxValue": 1, "defaultValue": 0 },
    { "identifier": "hslGreenSat", "displayName": "Green Saturation", "type": "float", "track": "sat:120", "group": "HSL", "groupCollapsed": true, "minValue": -1, "maxValue": 1, "defaultValue": 0 },
    { "identifier": "hslGreenLum", "displayName": "Green Luminance", "type": "float", "track": "lum:120", "group": "HSL", "groupCollapsed": true, "minValue": -1, "maxValue": 1, "defaultValue": 0 },

    { "identifier": "hslAquaHue", "displayName": "Aqua Hue", "type": "float", "track": "hue:180", "group": "HSL", "groupCollapsed": true, "minValue": -1, "maxValue": 1, "defaultValue": 0 },
    { "identifier": "hslAquaSat", "displayName": "Aqua Saturation", "type": "float", "track": "sat:180", "group": "HSL", "groupCollapsed": true, "minValue": -1, "maxValue": 1, "defaultValue": 0 },
    { "identifier": "hslAquaLum", "displayName": "Aqua Luminance", "type": "float", "track": "lum:180", "group": "HSL", "groupCollapsed": true, "minValue": -1, "maxValue": 1, "defaultValue": 0 },

    { "identifier": "hslBlueHue", "displayName": "Blue Hue", "type": "float", "track": "hue:225", "group": "HSL", "groupCollapsed": true, "minValue": -1, "maxValue": 1, "defaultValue": 0 },
    { "identifier": "hslBlueSat", "displayName": "Blue Saturation", "type": "float", "track": "sat:225", "group": "HSL", "groupCollapsed": true, "minValue": -1, "maxValue": 1, "defaultValue": 0 },
    { "identifier": "hslBlueLum", "displayName": "Blue Luminance", "type": "float", "track": "lum:225", "group": "HSL", "groupCollapsed": true, "minValue": -1, "maxValue": 1, "defaultValue": 0 },

    { "identifier": "hslPurpleHue", "displayName": "Purple Hue", "type": "float", "track": "hue:270", "group": "HSL", "groupCollapsed": true, "minValue": -1, "maxValue": 1, "defaultValue": 0 },
    { "identifier": "hslPurpleSat", "displayName": "Purple Saturation", "type": "float", "track": "sat:270", "group": "HSL", "groupCollapsed": true, "minValue": -1, "maxValue": 1, "defaultValue": 0 },
    { "identifier": "hslPurpleLum", "displayName": "Purple Luminance", "type": "float", "track": "lum:270", "group": "HSL", "groupCollapsed": true, "minValue": -1, "maxValue": 1, "defaultValue": 0 },

