    { "identifier": "hslMagentaSat", "displayName": "Magenta Saturation", "type": "float", "track": "sat:300", "group": "HSL", "groupCollapsed": true, "minValue": -1, "maxValue": 1, "defaultValue": 0 },
    { "identifier": "hslMagentaLum", "displayName": "Magenta Luminance", "type": "float", "track": "lum:300", "group": "HSL", "groupCollapsed": true, "minValue": -1, "maxValue": 1, "defaultValue": 0 },
    { "identifier": "look", "displayName": "Look", "type": "lut", "group": "Look", "defaultValue": "" },
    { "identifier": "lookAmount", "displayName": "Look Intensity", "type": "float", "group": "Look", "minValue": 0, "maxValue": 1, "defaultValue": 1 }
  ],
  "backend": "gpu",
  "pipeline": {
    "intermediateBuffers": [],
    "passes": [
      {
        "passIndex": 0,
        "fragmentShader": "main.frag",
        "inputs": [
          { "type": "source_texture" }
        ],
        "output": { "type": "canvas" }
      }
    ]
  }
