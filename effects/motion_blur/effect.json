{
  "id": "motion.blur",
  "displayName": "Motion Blur",
  "category": "impact",
  "thumbnail": "thumbnail.webp",
  "order": 94,
  "description": "Blurs movement inside the footage along its direction, as a camera shutter would, by measuring the motion towards the previous and the next frame. Moving objects smear past their outline onto what is behind them. Strength exaggerates the smear beyond a real shutter. Looks one frame ahead as well as behind, so acceleration bends the smear; the first and last frames of a clip blur from one side only, and frames while scrubbing are not blurred. The clip's own keyframed movement is not blurred.",
  "backend": "gpu",
  "history": 1,
  "historyExact": 1,
  "future": 1,
  "nextFeatures": ["history:source", "history:exact", "history:future", "buffer:float"],
  "parameters": [
    {
      "identifier": "shutter",
      "displayName": "Shutter angle",
      "type": "float",
      "minValue": 1,
      "maxValue": 360,
      "defaultValue": 180
    },
    {
      "identifier": "samples",
      "displayName": "Samples",
      "type": "int",
      "minValue": 2,
      "maxValue": 32,
      "defaultValue": 12
    },
    {
      "identifier": "maxBlur",
      "displayName": "Max length (% of width)",
      "type": "float",
      "minValue": 0.5,
      "maxValue": 25,
      "defaultValue": 8
    },
    {
      "identifier": "strength",
      "displayName": "Strength",
      "type": "float",
      "minValue": 0,
      "maxValue": 4,
      "defaultValue": 1
    }
  ],
  "pipeline": {
    "intermediateBuffers": [
      {"id": "luma4", "scale": 0.25},
      {"id": "luma16", "scale": 0.0625},
      {"id": "luma64", "scale": 0.015625},
      {"id": "flow64", "scale": 0.015625, "format": "rg16f"},
      {"id": "flow64f", "scale": 0.015625, "format": "rg16f"},
      {"id": "flow16", "scale": 0.0625, "format": "rg16f"},
      {"id": "flow16f", "scale": 0.0625, "format": "rg16f"},
      {"id": "flow4", "scale": 0.25, "format": "rg16f"},
      {"id": "flow4f", "scale": 0.25, "format": "rg16f"},
      {"id": "flow4s", "scale": 0.25, "format": "rg16f"},
      {"id": "flow4fs", "scale": 0.25, "format": "rg16f"},
      {"id": "tile16", "scale": 0.0625, "format": "rg16f"},
      {"id": "nbr16", "scale": 0.0625, "format": "rg16f"}
    ],
    "passes": [
      {"passIndex": 0, "fragmentShader": "luma4.frag",
       "inputs": [{"type": "source_texture"}], "output": {"type": "buffer", "id": "luma4"}},
      {"passIndex": 1, "fragmentShader": "luma16.frag",
       "inputs": [{"type": "buffer", "id": "luma4"}], "output": {"type": "buffer", "id": "luma16"}},
      {"passIndex": 2, "fragmentShader": "luma16.frag",
       "inputs": [{"type": "buffer", "id": "luma16"}], "output": {"type": "buffer", "id": "luma64"}},
      {"passIndex": 3, "fragmentShader": "match64.frag",
       "inputs": [{"type": "buffer", "id": "luma64"}], "output": {"type": "buffer", "id": "flow64"}},
      {"passIndex": 4, "fragmentShader": "match64f.frag",
       "inputs": [{"type": "buffer", "id": "luma64"}], "output": {"type": "buffer", "id": "flow64f"}},
      {"passIndex": 5, "fragmentShader": "match16.frag",
       "inputs": [{"type": "buffer", "id": "luma16"}, {"type": "buffer", "id": "flow64"}],
       "output": {"type": "buffer", "id": "flow16"}},
      {"passIndex": 6, "fragmentShader": "match16f.frag",
       "inputs": [{"type": "buffer", "id": "luma16"}, {"type": "buffer", "id": "flow64f"}],
       "output": {"type": "buffer", "id": "flow16f"}},
      {"passIndex": 7, "fragmentShader": "match4.frag",
       "inputs": [{"type": "buffer", "id": "luma4"}, {"type": "buffer", "id": "flow16"}],
       "output": {"type": "buffer", "id": "flow4"}},
      {"passIndex": 8, "fragmentShader": "match4f.frag",
       "inputs": [{"type": "buffer", "id": "luma4"}, {"type": "buffer", "id": "flow16f"}],
       "output": {"type": "buffer", "id": "flow4f"}},
      {"passIndex": 9, "fragmentShader": "smooth.frag",
       "inputs": [{"type": "buffer", "id": "flow4"}], "output": {"type": "buffer", "id": "flow4s"}},
      {"passIndex": 10, "fragmentShader": "smooth.frag",
       "inputs": [{"type": "buffer", "id": "flow4f"}], "output": {"type": "buffer", "id": "flow4fs"}},
      {"passIndex": 11, "fragmentShader": "tilemax.frag",
       "inputs": [{"type": "buffer", "id": "flow4s"}, {"type": "buffer", "id": "flow4fs"}],
       "output": {"type": "buffer", "id": "tile16"}},
      {"passIndex": 12, "fragmentShader": "nbrmax.frag",
       "inputs": [{"type": "buffer", "id": "tile16"}], "output": {"type": "buffer", "id": "nbr16"}},
      {"passIndex": 13, "fragmentShader": "blur.frag",
       "inputs": [{"type": "source_texture"}, {"type": "buffer", "id": "flow4s"}, {"type": "buffer", "id": "nbr16"},
                  {"type": "buffer", "id": "flow4fs"}],
       "output": {"type": "canvas"}}
    ]
  }
}
