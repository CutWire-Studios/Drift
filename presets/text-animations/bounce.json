{
  "format": 1, "id": "bounce", "label": "Bounce", "category": "basic", "sampleText": "Boing",
  "slots": ["in", "out"], "order": 70,
  "defaults": { "duration": 0.6 },
  "flags": { "easeLocked": true },
  "params": [ { "id": "distance", "type": "scalar", "label": "Distance", "unit": "box", "min": 0, "max": 2, "step": 0.05, "default": 0.35 } ],
  "animators": [
    { "selectors": [ { "driver": "stagger", "domain": "{unit}", "order": "{order}", "staggerUs": { "$": "stagger", "mul": 1000000 }, "durationUs": { "$": "duration", "mul": 1000000 }, "ease": "bounce" } ],
      "props": { "position": { "x": 0, "y": "{distance}", "unit": "box" } } },
    { "selectors": [ { "driver": "stagger", "domain": "{unit}", "order": "{order}", "staggerUs": { "$": "stagger", "mul": 1000000 }, "durationUs": { "$": "duration", "mul": 250000 }, "ease": "linear" } ],
      "props": { "opacity": 0 } }
  ]
}
