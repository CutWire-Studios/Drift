{
  "format": 1,
  "id": "colour-pulse",
  "label": "Colour pulse",
  "category": "colour",
  "sampleText": "Colour",
  "slots": [
    "loop"
  ],
  "order": 460,
  "params": [
    {
      "id": "colorA",
      "type": "color",
      "label": "Colour A",
      "default": "#ffff2bd6"
    },
    {
      "id": "colorB",
      "type": "color",
      "label": "Colour B",
      "default": "#ff2bd6ff"
    },
    {
      "id": "speed",
      "type": "scalar",
      "label": "Speed",
      "unit": "Hz",
      "min": 0.1,
      "max": 3,
      "step": 0.1,
      "default": 0.5
    }
  ],
  "animators": [
    {
      "selectors": [
        {
          "driver": "wiggle",
          "domain": "character",
          "wave": "sine",
          "frequencyHz": "{speed}",
          "spatialPhaseDeg": 34.4,
          "minAmount": 0,
          "maxAmount": 100
        }
      ],
      "props": {
        "fillColor": "{colorA}"
      }
    },
    {
      "selectors": [
        {
          "driver": "wiggle",
          "domain": "character",
          "wave": "sine",
          "frequencyHz": "{speed}",
          "spatialPhaseDeg": 34.4,
          "minAmount": 0,
          "maxAmount": 100,
          "temporalPhaseDeg": 180
        }
      ],
      "props": {
        "fillColor": "{colorB}"
      }
    }
  ]
}
