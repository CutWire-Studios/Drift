{
  "format": 1,
  "id": "fade-shift",
  "label": "Fade away",
  "category": "basic",
  "sampleText": "Bye",
  "slots": [
    "out"
  ],
  "order": 300,
  "defaults": {
    "unit": "block",
    "duration": 0.45,
    "ease": "easeIn"
  },
  "params": [
    {
      "id": "rise",
      "type": "scalar",
      "label": "Rise",
      "unit": "em",
      "min": -3,
      "max": 3,
      "step": 0.05,
      "default": 0.5
    },
    {
      "id": "blur",
      "type": "scalar",
      "label": "Blur",
      "unit": "px",
      "min": 0,
      "max": 48,
      "step": 1,
      "default": 0
    }
  ],
  "animators": [
    {
      "selectors": [
        "stagger"
      ],
      "props": {
        "position": {
          "x": 0,
          "y": {
            "$": "rise",
            "mul": -1
          },
          "unit": "em"
        },
        "opacity": 0,
        "blur": "{blur}"
      }
    }
  ]
}
