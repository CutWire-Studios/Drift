      "unit": "em",
      "min": 0,
      "max": 3,
      "step": 0.05,
      "default": 0.35
    }
  ],
  "animators": [
    {
      "selectors": [
        "stagger"
      ],
      "props": {
        "position": {
          "x": 0,
          "y": "{rise}",
          "unit": "em"
        },
        "opacity": 0
      }
    }
  ]
}
