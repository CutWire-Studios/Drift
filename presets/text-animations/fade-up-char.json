{
  "format": 1,
  "id": "fade-up-char",
  "label": "Fade up",
  "category": "character",
  "sampleText": "Fade up",
  "slots": [
    "in",
    "out"
  ],
  "order": 120,
  "defaults": {
    "unit": "character",
    "stagger": 0.03,
    "duration": 0.4,
    "ease": "smooth"
