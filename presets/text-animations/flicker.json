{
  "format": 1,
  "id": "flicker",
  "label": "Flicker",
  "category": "light",
  "sampleText": "Flicker",
  "slots": [
    "loop"
  ],
  "order": 450,
  "params": [
    {
      "id": "intensity",
      "type": "scalar",
      "label": "Intensity",
      "unit": "",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "default": 0.5
    },
    {
      "id": "speed",
      "type": "scalar",
      "label": "Rate",
      "unit": "Hz",
      "min": 1,
      "max": 30,
      "step": 1,
      "default": 8
    }
  ],
  "animators": [
    {
      "selectors": [
        {
          "driver": "wiggle",
          "domain": "block",
          "wave": "noise",
          "frequencyHz": "{speed}",
          "spatialPhaseDeg": 34.4,
          "minAmount": -100,
          "maxAmount": 100
        }
      ],
      "props": {
        "opacity": {
          "$": "intensity",
          "mul": -100,
          "add": 100
        }
      }
    }
  ]
}
