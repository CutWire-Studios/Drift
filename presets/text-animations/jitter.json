{
  "format": 1,
  "id": "jitter",
  "label": "Jitter",
  "category": "kinetic",
  "sampleText": "Jitter",
  "slots": [
    "loop"
  ],
  "order": 430,
  "params": [
    {
      "id": "amount",
      "type": "scalar",
      "label": "Amount",
      "unit": "px",
      "min": 0,
      "max": 10,
      "step": 0.5,
      "default": 1.5
    },
    {
      "id": "angle",
      "type": "scalar",
      "label": "Angle",
      "unit": "\u00b0",
      "min": 0,
      "max": 15,
      "step": 0.5,
      "default": 2
    },
    {
      "id": "speed",
      "type": "scalar",
      "label": "Rate",
      "unit": "Hz",
      "min": 1,
      "max": 30,
      "step": 1,
      "default": 12
    }
  ],
  "animators": [
    {
      "selectors": [
        {
          "driver": "wiggle",
          "domain": "character",
          "wave": "noise",
          "frequencyHz": "{speed}",
          "spatialPhaseDeg": 97,
          "minAmount": -100,
          "maxAmount": 100
        }
      ],
      "props": {
        "position": {
          "x": "{amount}",
          "y": "{amount}",
          "unit": "px"
        },
        "rotation": "{angle}"
      }
    }
  ]
}
