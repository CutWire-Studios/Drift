{
  "format": 1,
  "id": "swing",
  "label": "Swing",
  "category": "kinetic",
  "sampleText": "Swing",
  "slots": [
    "loop"
  ],
  "order": 440,
  "params": [
    {
      "id": "angle",
      "type": "scalar",
      "label": "Angle",
      "unit": "\u00b0",
      "min": 0,
      "max": 30,
      "step": 0.5,
      "default": 3
    },
    {
      "id": "speed",
      "type": "scalar",
      "label": "Speed",
      "unit": "Hz",
      "min": 0.1,
      "max": 3,
      "step": 0.1,
      "default": 0.6
    }
  ],
  "animators": [
    {
      "selectors": [
        {
          "driver": "wiggle",
          "domain": "word",
          "wave": "sine",
          "frequencyHz": "{speed}",
          "spatialPhaseDeg": 45,
          "minAmount": -100,
          "maxAmount": 100
        }
      ],
      "props": {
        "rotation": "{angle}"
      }
    }
  ]
}
