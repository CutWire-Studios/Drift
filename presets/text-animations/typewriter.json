{
  "format": 1, "id": "typewriter", "label": "Typewriter", "category": "character", "sampleText": "Typing",
  "slots": ["in", "out"], "order": 50,
  "defaults": { "unit": "character", "stagger": 0.06 },
  "flags": { "durationLocked": true, "mirrorForOut": false },
  "params": [
    { "id": "caret", "type": "bool", "label": "Caret", "default": false },
    { "id": "lead", "type": "scalar", "label": "Caret lead", "unit": "s", "min": 0, "max": 2, "step": 0.05, "default": 0.2 },
    { "id": "blink", "type": "scalar", "label": "Blink", "unit": "Hz", "min": 0.5, "max": 8, "step": 0.5, "default": 2 },
    { "id": "hold", "type": "scalar", "label": "Hold after", "unit": "s", "min": 0, "max": 5, "step": 0.1, "default": 0.5 },
    { "id": "collapse", "type": "bool", "label": "Re-centre as it types", "default": false }
  ],
  "animators": [ {
    "selectors": [ { "driver": "stagger", "domain": "{unit}", "order": "{order}", "staggerUs": { "$": "stagger", "mul": 1000000 }, "durationUs": 0 } ],
    "props": { "opacity": 0 }, "collapseHidden": "{collapse}"
  } ],
  "caret": { "enabled": "{caret}", "leadUs": { "$": "lead", "mul": 1000000 }, "blinkOnUs": 200000, "blinkOffUs": 300000, "holdAfterUs": { "$": "hold", "mul": 1000000 } }
}
