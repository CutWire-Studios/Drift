{
  "format": 1,
  "id": "wipe",
  "label": "Wipe",
  "category": "kinetic",
  "sampleText": "Type",
  "slots": [
    "in",
    "out"
  ],
  "order": 170,
  "defaults": {
    "unit": "block",
    "duration": 0.6,
    "ease": "easeOut"
  },
  "flags": {
    "unitLocked": true,
    "orderLocked": true,
    "mirrorForOut": false
