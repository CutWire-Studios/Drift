<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Only applied under the hardened runtime, which is only enabled when signing with a real
         identity for notarisation. -->

    <!-- QtQml compiles bindings at runtime; the hardened runtime blocks that by default. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>

    <!-- Acceleration addons are ONNX Runtime builds downloaded after install and signed by
         someone else, so library validation would refuse to dlopen them (OrtRuntime.cpp) and
         auto-subtitles, segmentation and face tracking would all go missing. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
