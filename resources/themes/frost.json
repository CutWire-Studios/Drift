    "primaryHover": "#121212",
    "primaryForeground": "#ffffff",
    "accentOnPanel": "#1a1a1a",
    "accent": "#e8e8ec",
    "accentHover": "#D7D7DB",
    "accentForeground": "#0a0a0a",
    "panelAccent": "#14000000",
    "panelAccentForeground": "#0a0a0a",
    "panelMuted": "#d0d0d4",
    "popoverHover": "#0f000000",
