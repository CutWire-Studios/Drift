// Configured into the build tree by CMakeLists.txt, so the icon path is absolute.
#include <winver.h>

// Windows application icon (title bar / taskbar / Explorer).
IDI_ICON1 ICON "@CMAKE_SOURCE_DIR@/resources/windows/drift.ico"

// Without this, Explorer, Event Viewer and WER report the exe as version 0.0.0.0.
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "CutWire Studios"
            VALUE "FileDescription", "@DRIFT_APP_NAME@"
            VALUE "FileVersion", "@DRIFT_VERSION_STRING@"
            VALUE "InternalName", "drift"
            VALUE "OriginalFilename", "drift.exe"
            VALUE "ProductName", "@DRIFT_APP_NAME@"
            VALUE "ProductVersion", "@DRIFT_VERSION_STRING@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
