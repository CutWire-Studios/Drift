{
  "id": "particle_wind",
  "displayName": "Particle Wind",
  "category": "liquid",
  "order": 300,
  "parameters": [
    {
      "identifier": "strength",
      "displayName": "Wind Strength",
      "type": "float",
      "minValue": 0.0,
      "maxValue": 1.0,
      "defaultValue": 0.45
    },
    {
      "identifier": "turbulence",
      "displayName": "Turbulence",
      "type": "float",
      "minValue": 0.0,
      "maxValue": 1.0,
      "defaultValue": 0.5
    },
    {
      "identifier": "grain",
      "displayName": "Grain",
      "type": "float",
      "minValue": 4,
      "maxValue": 80,
      "defaultValue": 30
    },
    {
      "identifier": "spread",
      "displayName": "Dissolve Spread",
      "type": "float",
      "minValue": 0.0,
      "maxValue": 1.0,
      "defaultValue": 0.6
    },
    {
      "identifier": "direction",
      "displayName": "Direction",
      "type": "float",
      "minValue": 0,
      "maxValue": 360,
      "defaultValue": 0
    }
  ],
  "pipeline": {
    "intermediateBuffers": [
      {
        "id": "flow",
        "scale": 0.5
      }
    ],
    "passes": [
      {
        "passIndex": 0,
        "fragmentShader": "flow.frag",
        "inputs": [
          {
            "type": "source_texture",
            "index": 0
          }
        ],
        "output": {
          "type": "buffer",
          "id": "flow"
        }
      },
      {
        "passIndex": 1,
        "fragmentShader": "main.frag",
        "inputs": [
          {
            "type": "buffer",
            "id": "flow"
          },
          {
            "type": "source_texture",
            "index": 0
          },
          {
            "type": "source_texture",
            "index": 1
          }
        ],
        "output": {
          "type": "canvas"
        }
      }
    ]
  }
}
